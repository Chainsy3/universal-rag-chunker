{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extracted_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_id",
        "display_name",
        "media_type",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "config_digest"
      ],
      "additionalProperties": false
    },
    "document_type": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^block_[0-9a-f]{64}$"
          },
          "type": {
            "enum": [
              "heading",
              "paragraph",
              "list_item",
              "code",
              "table_row"
            ],
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "text",
                    "type": "string"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "page"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "page"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "docx"
                  },
                  "body_index": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "body_index"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "sheet"
                  },
                  "sheet_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column_end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "sheet_name",
                  "row",
                  "column_start",
                  "column_end"
                ],
                "additionalProperties": false
              }
            ]
          },
          "attributes": {
            "type": "object"
          }
        },
        "required": [
          "block_id",
          "type",
          "order",
          "parent_id",
          "text",
          "locator",
          "attributes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "source",
    "parser",
    "document_type",
    "blocks",
    "metadata"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document-ir 1.1"
}
